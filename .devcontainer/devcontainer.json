{
  "name": "PubCast phone browser test",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "PubCast test app",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "python tools/codespaces/start_pubcast.py"
}
