# ══════════════════════════════════════════════════════════════════
# PubCast AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PUBCAST_JWT_SECRET=change-me-generate-a-real-secret

# Owner account — created automatically on first startup if no users exist
PUBCAST_OWNER_USERNAME=owner
PUBCAST_OWNER_PASSWORD=change-me-strong-password-here

# ── AI PROVIDERS (set whichever you use) ──────────────────────────

PUBCAST_ANTHROPIC_KEY=sk-ant-...
PUBCAST_OPENAI_KEY=sk-...
PUBCAST_GOOGLE_KEY=AIza...

# Local Ollama model for PubCast bots and Studio mind.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ministral-pubcast:3b
STUDIO_MODEL=ministral-pubcast:3b
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=1h

# ── SERVER ────────────────────────────────────────────────────────

PUBCAST_HOST=0.0.0.0
PUBCAST_PORT=8000
PUBCAST_DEBUG=0

# Optional research protocol. Keep disabled for PubCast core/public builds.
ENABLE_ALEX_LITTLE_ONE=false

# ── STORAGE PATHS ─────────────────────────────────────────────────

PUBCAST_DATA_DIR=data
PUBCAST_ASSETS_DIR=assets
PUBCAST_STATIC_DIR=static

# ── TTS (optional — requires Larynx/Piper running separately) ─────

PUBCAST_LARYNX_HOST=127.0.0.1
PUBCAST_LARYNX_PORT=5002
PUBCAST_PIPER_MODEL=en_US-lessac-medium

# ── RECORDING ─────────────────────────────────────────────────────

PUBCAST_MAX_RECORDING_HOURS=4
