    def test_full_host_uses_one_shared_bridge_connection_attempt_per_lifespan():
        import main
    
        # Reach intentionally keeps an app singleton across TestClient entries.  Other
        # lifecycle tests may therefore have already exercised the same bridge object.
        # Measure connection attempts relative to the pre-entry count rather than
        # assuming a brand-new process/bridge with a literal zero counter.
        existing_bridge = getattr(main, "voxel_bridge", None)
        attempts_before = getattr(existing_bridge, "_connection_attempts", 0)
    
        with TestClient(main.app):
            bridge = main.voxel_bridge
            twin = main.app.state.twin_engine
            pete = main.app.state.pete_enhanced
            assert bridge is not None
            assert twin.bridge is bridge
            assert pete.bridge is bridge
            assert pete._owns_bridge is False
