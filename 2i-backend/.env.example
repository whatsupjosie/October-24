# 2i BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=8787
NODE_ENV=development

# Anthropic API
# Get your key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-opus-4-8

# PubPartner Integration (when ready)
PUBPARTNER_URL=http://localhost:8000
PUBPARTNER_API_KEY=

# Local LLM Integration (optional)
# For Ollama or other local services
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=mistral

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/2i-backend.log

# CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Session/Storage
STORAGE_TYPE=memory
# For production: file, database, etc.

# Admin operations (REQUIRED for DELETE /api/messages/clear to work)
# Without this set, that endpoint returns 503 and refuses all requests
# (fails closed — never defaults to open access). Set to a long random
# string, not a guessable word.
ADMIN_KEY=

# Outbound budget for the PubPartner compatibility call, in milliseconds.
# Default 30000. Invalid or non-positive values fall back to the default;
# there is deliberately no way to disable the timeout.
PUBPARTNER_TIMEOUT_MS=30000
