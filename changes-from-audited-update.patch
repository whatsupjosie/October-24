+    const blob=new Blob([JSON.stringify(docPayload(),null,2)],{type:'application/json'});
+    const saved=await ForesightFiles.workspace('file',{path:nativeWorkspace.path,data:await ForesightFiles.encode(blob),expected_revision:nativeWorkspace.revision});
