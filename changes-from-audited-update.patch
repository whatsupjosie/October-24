+  await ForesightFiles.record(key).then(v=>{if(v?.twoiState&&!documentDirty&&!committed.length){nativeWorkspace=v.workspace;documentTitle=v.name;loadDocState(v.twoiState);soloTextarea.value=committed.join('\n');render()}}).catch(console.error);
